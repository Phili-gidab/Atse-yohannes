# Copy to .env.local and fill in. Anything missing causes the app to fall back
# to the static seed data in src/data/content.ts (no crashes).

# --- Firebase (Web SDK config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Upload provider ---
# "firebase" (Firebase Storage, requires Blaze plan) or "cloudinary"
VITE_UPLOAD_PROVIDER=firebase

# --- Cloudinary (only used when VITE_UPLOAD_PROVIDER=cloudinary) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Stripe (publishable only on the client; secret key lives in Cloud Functions) ---
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Cloud Function endpoints (set after deploy) ---
VITE_FUNCTIONS_BASE_URL=
